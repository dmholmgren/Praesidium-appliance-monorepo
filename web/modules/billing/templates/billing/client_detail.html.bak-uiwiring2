<script>
var CLIENT_ID = "{{ client.id }}";



// Matter filter toggle (active/all) — operates on rendered widget rows
let matterFilter = 'active';
function setMF(f) {
  matterFilter = f;
  document.querySelectorAll('.matter-inactive').forEach(r => {
    r.style.display = f === 'all' ? '' : 'none';
  });
  ['active', 'all'].forEach(k => {
    const b = document.getElementById(`mf-${k}`);
    if (!b) return;
    if (k === f) {
      b.style.background = 'var(--primary)'; b.style.color = '#fff';
      b.style.borderColor = 'var(--primary)';
    } else {
      b.style.background = '#fff'; b.style.color = 'var(--muted)';
      b.style.borderColor = 'var(--border)';
    }
  });
  updateMatterCount();
}

function updateMatterCount() {
  const all    = document.querySelectorAll('.matter-row').length;
  const active = document.querySelectorAll('.matter-row:not(.matter-inactive)').length;
  const el = document.getElementById('matter-count');
  if (el) el.textContent = `(${active} active${all !== active ? ', ' + all + ' total' : ''})`;
}

// Slip filter toggle — shows/hides rows by data-billed attr
let slipFilter = 'all';
function setSF(f) {
  slipFilter = f;
  document.querySelectorAll('.slip-row').forEach(r => {
    const billed = r.dataset.billed === 'true';
    if (f === 'wip')    r.style.display = billed ? 'none' : '';
    else if (f === 'billed') r.style.display = billed ? '' : 'none';
    else r.style.display = '';
  });
  ['all', 'wip', 'billed'].forEach(k => {
    const b = document.getElementById(`sf-${k}`);
    if (!b) return;
    if (k === f) {
      b.style.background = 'var(--primary)'; b.style.color = '#fff';
      b.style.borderColor = 'var(--primary)';
    } else {
      b.style.background = '#fff'; b.style.color = 'var(--muted)';
      b.style.borderColor = 'var(--border)';
    }
  });
}

function generatePrebill() {
  alert('Prebill generation for all active matters — coming in next build.');
}
</script>

