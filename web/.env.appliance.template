# Praesidium WEB — Appliance .env template
#
# Captures the env surface from the legacy WEB-01 .env, with appliance-
# appropriate defaults. Sections grouped by concern.
#
# Required edits before first start:
#   1. DATABASE_URL    — replace CHANGEME with appliance DB password
#   2. SECRET_KEY      — generate: openssl rand -hex 32
#   3. JWT_SECRET      — generate: openssl rand -hex 32
#   4. ANTHROPIC_API_KEY, OPENAI_API_KEY, VOYAGE_API_KEY
#
# Optional:
#   - CIFS_*       — only relevant if storage adapter uses bridge fallback
#   - LDAP_*       — for AD-backed auth
#   - EXCHANGE_*   — for Exchange calendar sync
#   - LEXIS_*      — research connector
#   - WESTLAW_*    — research connector
#
# chmod 600 .env after editing.

# ─── Tenancy ─────────────────────────────────────────────────────────
TENANT_ID=ca4a6450-fe63-4fea-aeba-9faf2bb122d6
PLATFORM_DOMAIN=praesidium-legal.com
TENANT_DOMAIN=hjmmlegal.com

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://praesidium:CHANGEME@host.docker.internal:5432/praesidium
SQL_ECHO=false

# ─── Redis ───────────────────────────────────────────────────────────
# Web uses redis for rate limiting, session cache, and enqueue paths.
# Service name 'redis' resolves on praesidium-internal because the
# proc compose creates it.
REDIS_URL=redis://redis:6379/0

# ─── Branding ────────────────────────────────────────────────────────
BRANDING_CACHE_TTL=300

# ─── Search ──────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
MEILISEARCH_URL=http://elasticsearch:9200
MEILISEARCH_MASTER_KEY=
MEILISEARCH_ENV=production

# ─── Whisper / transcription ─────────────────────────────────────────
WHISPER_SERVICE_URL=http://10.10.60.14:9001
WHISPER_URL=http://10.10.60.14:9001
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─── Auth / Session ──────────────────────────────────────────────────
SECRET_KEY=
SESSION_COOKIE_NAME=praesidium_session
JWT_SECRET=
WEB_WORKERS=1
LOG_LEVEL=INFO

# ─── Storage / Mounts ────────────────────────────────────────────────
LEGACY_QNAP_ROOT=/mnt/legacy-qnap
PRAESIDIUM_STORAGE_ROOT=/mnt/praesidium
EDISCOVERY_STORAGE_ROOT=/mnt/ediscovery
WEBDAV_PORT=8081
# Legacy CIFS bridge fields preserved for code paths that still reference
# them; storage adapter refactor will retire most of these. Leave blank
# unless you need them.
CIFS_URL=
CIFS_TIMEOUT=30
CIFS_SHARE_PATH=/mnt/praesidium
CIFS_USERNAME=
CIFS_PASSWORD=
CIFS_DOMAIN=

# ─── RQ ──────────────────────────────────────────────────────────────
RQ_QUEUES=ocr,index,crawl,default,ediscovery_proc,migration

# ─── AI: Generation ──────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-small

# ─── AI: Embedding (Voyage Law 2) ────────────────────────────────────
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-law-2
VOYAGE_API_KEY=

# ─── Email / Exchange / Graph ────────────────────────────────────────
EMAIL_ADAPTER=
EXCHANGE_SERVER=
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=
EXCHANGE_DOMAIN=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ─── Google ──────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DELEGATED_USER=
CALENDAR_ADAPTER=

# ─── Telephony ───────────────────────────────────────────────────────
FREEPBX_API_URL=
FREEPBX_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Legal research connectors ───────────────────────────────────────
RESEARCH_ADAPTER=
LEXIS_API_URL=
LEXIS_API_KEY=
LEXIS_TIMEOUT=30
WESTLAW_API_URL=
WESTLAW_API_KEY=
WESTLAW_CLIENT_ID=
WESTLAW_CLIENT_SECRET=
WESTLAW_TIMEOUT=30

# ─── Accounting ──────────────────────────────────────────────────────
ACCOUNTING_ADAPTER=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# ─── LDAP / AD ───────────────────────────────────────────────────────
AUTH_ADAPTER=local
LDAP_URL=
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_GROUP_SEARCH_BASE=
LDAP_USER_FILTER=
LDAP_VERIFY_CERT=true

# ─── Azure AD ────────────────────────────────────────────────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
