<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ brand.platform_name if brand else 'Praesidium' }}{% endblock %}</title>
  {% if brand and brand.favicon_url %}
  <link rel="icon" href="{{ brand.favicon_url }}" type="image/x-icon">
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  <style>
    :root {
      --primary:   {{ brand.primary_color if brand else '#0D1F3C' }};
      --accent:    {{ brand.accent_color if brand else '#C8923A' }};
      --sidebar-w: 220px;
      --border:    #E5E7EB;
      --text:      #111827;
      --muted:     #6B7280;
      --bg:        #F9FAFB;
      --surface:   #FFFFFF;
      --sidebar-bg:#FFFFFF;
      --header-bg: #FFFFFF;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    /* ── Sidebar ── */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--sidebar-bg);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .sidebar-brand {
      padding: 20px 16px 16px;
      border-bottom: 1px solid var(--border);
    }

    .brand-name {
      font-family: 'Lora', serif;
      font-weight: 600;
      font-size: 16px;
      color: var(--primary);
      letter-spacing: -0.01em;
    }

    .brand-tagline {
      font-size: 10px;
      font-weight: 400;
      color: var(--muted);
      margin-top: 2px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav-section {
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #9CA3AF;
      padding: 16px 16px 4px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      font-size: 13px;
      font-weight: 400;
      color: var(--muted);
      text-decoration: none;
      transition: all 120ms;
      border-left: 2px solid transparent;
    }

    .nav-link:hover {
      color: var(--text);
      background: var(--bg);
    }

    .nav-link.active {
      color: var(--primary);
      background: #EFF6FF;
      border-left-color: var(--primary);
      font-weight: 500;
    }

    .nav-link svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
      opacity: 0.7;
    }

    .nav-link.active svg { opacity: 1; }

    /* ── Header ── */
    .topbar {
      background: var(--header-bg);
      border-bottom: 1px solid var(--border);
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      flex-shrink: 0;
    }

    .topbar-title {
      font-family: 'Lora', serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
    }

    /* ── Content ── */
    .main-content {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
    }

    /* ── Cards ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 20px;
    }

    /* ── Tabs ── */
    .tab-nav {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .tab-btn {
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 400;
      color: var(--muted);
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      transition: all 120ms;
      margin-bottom: -1px;
      white-space: nowrap;
    }

    .tab-btn:hover { color: var(--text); }

    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 500;
    }

    /* ── Badges ── */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 500;
    }
    .badge-green  { background: #D1FAE5; color: #065F46; }
    .badge-gray   { background: #F3F4F6; color: #374151; }
    .badge-yellow { background: #FEF3C7; color: #92400E; }
    .badge-red    { background: #FEE2E2; color: #991B1B; }
    .badge-blue   { background: #DBEAFE; color: #1E40AF; }

    /* ── Buttons ── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: opacity 120ms;
      text-decoration: none;
    }
    .btn-primary:hover { opacity: 0.88; }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 13px;
      font-weight: 400;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 120ms;
      text-decoration: none;
    }
    .btn-secondary:hover { background: var(--bg); }

    /* ── Table ── */
    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .data-table th {
      text-align: left;
      padding: 8px 12px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }
    .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #F3F4F6;
      color: var(--text);
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #F9FAFB; }

    /* ── Empty states ── */
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: var(--muted);
      font-size: 13px;
    }

    /* ── HTMX loading ── */
    .htmx-indicator { opacity: 0; transition: opacity 200ms; }
    .htmx-request .htmx-indicator { opacity: 1; }
    .htmx-request.htmx-indicator { opacity: 1; }

    .panel-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 120px;
      color: var(--muted);
      font-size: 13px;
      gap: 8px;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 16px; height: 16px;
      border: 2px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      flex-shrink: 0;
    }

    /* ── Matter list ── */
    .matter-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition: background 100ms;
    }
    .matter-row:last-child { border-bottom: none; }
    .matter-row:hover { background: var(--bg); }
    .matter-name { font-weight: 500; font-size: 13px; color: var(--text); }
    .matter-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }

    /* ── Drag handles (SortableJS) ── */
    .panel-wrapper {
      position: relative;
      margin-bottom: 2px;
    }
    .drag-handle {
      position: absolute;
      top: 12px;
      right: 12px;
      cursor: grab;
      color: #D1D5DB;
      opacity: 0;
      transition: opacity 150ms;
    }
    .panel-wrapper:hover .drag-handle { opacity: 1; }
    .sortable-ghost { opacity: 0.4; }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 3px; }
  </style>
  {% block head_extra %}{% endblock %}
</head>
<body class="h-full flex">

  <!-- ── Sidebar ──────────────────────────────────────────────────────────── -->
  <nav class="sidebar">

    <div class="sidebar-brand">
      {% if brand and brand.logo_url %}
      <img src="{{ brand.logo_url }}" alt="{{ brand.platform_name }}" style="height:28px; width:auto; margin-bottom:2px;">
      {% else %}
      <div class="brand-name">{{ brand.platform_name if brand else 'PRAESIDIUM' }}</div>
      {% endif %}
      <div class="brand-tagline">{{ brand.tagline if brand and brand.tagline else 'Legal Intelligence' }}</div>
    </div>

    {% if active_matter %}
    <div style="padding:10px 16px; border-bottom:1px solid var(--border); background:var(--bg);">
      <div style="font-size:9px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#9CA3AF; margin-bottom:3px;">Active Matter</div>
      <div style="font-size:12px; font-weight:500; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ active_matter.matter_name }}</div>
    </div>
    {% endif %}

    <div style="flex:1; overflow-y:auto; padding-bottom:8px;">

      <div class="nav-section">Workspace</div>
      <a href="/dashboard" class="nav-link {% if page == 'dashboard' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      </a>
      <a href="/dms" class="nav-link {% if page == 'dms' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        Documents
      </a>

      <div class="nav-section">eDiscovery</div>
      <a href="/ediscovery" class="nav-link {% if page == 'ediscovery_home' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      </a>
      <a href="/ediscovery/review" class="nav-link {% if page == 'ediscovery' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        Review
      </a>
      <a href="/ediscovery/collections" class="nav-link {% if page == 'collections' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        Collections
      </a>
      <a href="/dms/search" class="nav-link {% if page == 'search' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Search
      </a>

      <div class="nav-section">Billing</div>
      <a href="/billing" class="nav-link {% if page == 'billing' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Billing
      </a>
      <a href="/billing/timesheet" class="nav-link {% if page == 'timesheets' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Timesheets
      </a>
      <a href="/billing/clients" class="nav-link {% if page == 'clients' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Clients
      </a>
      <a href="/billing/trust" class="nav-link {% if page == 'trust' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Trust
      </a>
      <a href="/billing/reports" class="nav-link {% if page == 'reports' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Reports
      </a>

      <div class="nav-section">Research</div>
      <a href="/dms/research" class="nav-link {% if page == 'research' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        Legal Research
      </a>

    </div>

      <div class="nav-section">Settings</div>
      <a href="/tenant-admin/" class="nav-link {% if page == 'admin' %}active{% endif %}">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Firm Settings
      </a>

    </div>

    <div style="padding:12px 16px; border-top:1px solid var(--border);">
      {% if current_user %}
      <div style="font-size:12px; font-weight:500; color:var(--text); margin-bottom:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
        {{ current_user.full_name if current_user.full_name else current_user.username }}
      </div>
      {% endif %}
      <a href="/auth/logout" style="font-size:11px; color:var(--muted); text-decoration:none;">Sign out</a>
      <div style="font-size:10px; color:#D1D5DB; margin-top:6px;">Patent Pending 64/020,027</div>
    </div>

  </nav>

  <!-- ── Main ─────────────────────────────────────────────────────────────── -->
  <div style="flex:1; display:flex; flex-direction:column; min-height:0; overflow:hidden;">

    <header class="topbar">
      <div style="display:flex; align-items:center; gap:10px;">
        <span class="topbar-title">{% block page_title %}{% endblock %}</span>
        <span id="global-spinner" class="htmx-indicator">
          <span class="spinner"></span>
        </span>
      </div>
      <div style="font-size:11px; color:var(--muted);" id="last-updated">
        {% block header_right %}{% endblock %}
      </div>
    </header>

    <main class="main-content">
      {% block content %}{% endblock %}
    </main>

  </div>

  <script>
    htmx.config.indicatorClass = 'htmx-request';
    htmx.config.allowScriptTags = true;
    document.body.addEventListener('htmx:afterRequest', function() {
      const el = document.getElementById('last-updated');
      if (el) el.textContent = 'Updated ' + new Date().toLocaleTimeString();
    });
  </script>
  {% block scripts_extra %}{% endblock %}
</body>
</html>
