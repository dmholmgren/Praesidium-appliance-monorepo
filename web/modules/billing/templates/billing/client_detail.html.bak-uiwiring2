// Load timekeepers into drawer select
async function loadTKOptions() {
  try {
    const res  = await fetch('/api/billing/timekeepers');
    const data = await res.json();
    const sel  = document.getElementById('edit-tk');
    (data.timekeepers || data).forEach(tk => {
      const opt = document.createElement('option');
      opt.value       = tk.ts_tk_id || tk.id;
      opt.textContent = `${tk.ts_name || tk.full_name} (${tk.ts_initials || tk.ts_tk_id || ''})`;
      sel.appendChild(opt);
    });
  } catch(e) {
    console.warn('Could not load timekeepers:', e);
  }
}
loadTKOptions();

let currentSlipId     = null;
let currentSlipSource = null;

window.openSlipDrawer = function(slip) {
  currentSlipId     = slip.source_slip_id || slip.id;
  currentSlipSource = slip.source || 'timeslips';

  document.getElementById('drawer-matter').textContent  = slip.matter_name || '';
  document.getElementById('edit-date').value            = slip.slip_date || '';
  document.getElementById('edit-tk').value              = slip.source_tk_id || '';
  document.getElementById('edit-hours').value           = parseFloat(slip.hours || 0).toFixed(2);
  document.getElementById('edit-rate').value            = parseFloat(slip.rate  || 0).toFixed(2);
  document.getElementById('edit-narrative').value       =
    (slip.narrative || '').replace(/paid by dmh[^;.]*/gi, '').replace(/\s{2,}/g,' ').trim();
  document.getElementById('edit-billed').value          = slip.billed ? 'true' : 'false';
  document.getElementById('drawer-error').style.display = 'none';
  document.getElementById('edit-source-row').style.display =
    currentSlipSource === 'timeslips' ? 'block' : 'none';

  updateDrawerValue();
  document.getElementById('slip-overlay').style.display = 'block';
  document.getElementById('slip-drawer').style.display  = 'flex';
};

window.closeSlipDrawer = function() {
  document.getElementById('slip-overlay').style.display = 'none';
  document.getElementById('slip-drawer').style.display  = 'none';
  currentSlipId = null;
};

window.updateDrawerValue = function() {
  const h = parseFloat(document.getElementById('edit-hours').value || 0);
  const r = parseFloat(document.getElementById('edit-rate').value  || 0);
  document.getElementById('drawer-value').textContent =
    '$' + (h * r).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
};

window.saveSlip = async function() {
  if (!currentSlipId) return;
  const btn = document.getElementById('save-btn');
  btn.textContent = 'Saving…'; btn.disabled = true;

  const payload = {
    slip_date:    document.getElementById('edit-date').value,
    source_tk_id: document.getElementById('edit-tk').value,
    hours:        parseFloat(document.getElementById('edit-hours').value),
    rate:         parseFloat(document.getElementById('edit-rate').value),
    narrative:    document.getElementById('edit-narrative').value.trim(),
    billed:       document.getElementById('edit-billed').value === 'true',
  };
  payload.wip_value    = payload.billed ? 0 : payload.hours * payload.rate;
  payload.billed_value = payload.billed ? payload.hours * payload.rate : 0;

  const errEl = document.getElementById('drawer-error');
  errEl.style.display = 'none';

  try {
    const res = await fetch(`/api/v1/billing/slips/${currentSlipId}`, {
      method:  'PUT',
      headers: {'Content-Type': 'application/json'},
      body:    JSON.stringify(payload),
    });
    if (res.ok) {
      closeSlipDrawer();
      // Reload KPI and slips widgets to reflect change
      htmx.trigger(document.getElementById('widget-client-kpi'),    'load');
      htmx.trigger(document.getElementById('widget-recent-slips'),  'load');
      htmx.trigger(document.getElementById('widget-wip-by-tk'),     'load');
    } else {
      const err = await res.json();
      errEl.textContent   = err.detail || 'Error saving slip.';
      errEl.style.display = 'block';
    }
  } catch(e) {
    errEl.textContent   = 'Network error. Please try again.';
    errEl.style.display = 'block';
  } finally {
    btn.textContent = 'Save Changes'; btn.disabled = false;
  }
};

})();
