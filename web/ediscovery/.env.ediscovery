# ═══════════════════════════════════════════════════════════════════
# eDiscovery Module (Chat 5) — Append to master .env
# ═══════════════════════════════════════════════════════════════════
# These vars are ONLY needed if not already in your master .env.
# The live HJMM .env already contains these from initial setup.
# Check with: grep EDISCOVERY /opt/praesidium/.env
#
# If missing, append this file:
#   sudo sh -c 'cat .env.ediscovery >> /opt/praesidium/.env'
# ═══════════════════════════════════════════════════════════════════

# ─── eDiscovery Storage ──────────────────────────────────────
# Verify mount: mountpoint -q /mnt/ediscovery && echo OK
EDISCOVERY_STORAGE_ROOT='/mnt/ediscovery'
EDISCOVERY_EMBEDDING_MODEL='all-MiniLM-L6-v2'
EDISCOVERY_MAX_FILE_SIZE_MB='500'
EDISCOVERY_OCR_DPI='300'
EDISCOVERY_FAISS_SIMILARITY_THRESHOLD='0.85'
EDISCOVERY_RQ_QUEUE='ediscovery_proc'
