    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
      <div>
        <label style="display:block; font-size:12px; font-weight:500;
                      color:#374151; margin-bottom:4px;">Hours</label>
        <input type="number" id="edit-hours" step="0.1" min="0" max="24"
               style="width:100%; border:1px solid #D1D5DB; border-radius:6px;
                      padding:8px 12px; font-size:13px;"
