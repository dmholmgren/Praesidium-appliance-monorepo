# ═══════════════════════════════════════════════════════════════════════════
# Praesidium Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in values. Never commit .env to version control.
# Rule 7: Config via environment variables only — no hardcoded values.
#
# HJMM Reference Deployment values shown in comments.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Tenant Identity ─────────────────────────────────────────────────────
TENANT_ID=<REPLACE>
# HJMM: UUID generated at first run

PLATFORM_DOMAIN=praesidium.legal
# The platform's own domain — used for {slug}.praesidium.legal pattern

TENANT_DOMAIN=<REPLACE>
# HJMM: hjmmlegal.com

# ─── Database (MariaDB 11) ───────────────────────────────────────────────
# VM: MAIN-PRD-DB-01 (10.10.60.11)
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>?charset=utf8mb4
# HJMM: mysql+pymysql://praesidium:SECURE_PASSWORD@10.10.60.11:3306/praesidium_hjmm?charset=utf8mb4

SQL_ECHO=
# Set to "1" for debug SQL logging — leave empty for production

# ─── Redis ───────────────────────────────────────────────────────────────
# VM: MAIN-PRD-PROC-01 (10.10.60.12)
REDIS_URL=redis://<host>:6379/0
# HJMM: redis://10.10.60.12:6379/0

BRANDING_CACHE_TTL=300
# BrandingService cache TTL in seconds (5 minutes)

# ─── Meilisearch ─────────────────────────────────────────────────────────
# VM: MAIN-PRD-PROC-01 (10.10.60.12)
MEILISEARCH_URL=http://<host>:7700
# HJMM: http://10.10.60.12:7700

MEILISEARCH_MASTER_KEY=<REPLACE>
MEILISEARCH_ENV=production

# ─── Whisper Speech Service ──────────────────────────────────────────────
# VM: MAIN-PRD-WSS-01 (10.10.60.14)
WHISPER_SERVICE_URL=http://<host>:9000
# HJMM: http://10.10.60.14:9000

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─── Web Server ──────────────────────────────────────────────────────────
SECRET_KEY=<REPLACE-WITH-SECURE-RANDOM-STRING>
SESSION_COOKIE_NAME=praesidium_session
WEB_WORKERS=4
LOG_LEVEL=info

# ─── File Bridge (CIFS) ─────────────────────────────────────────────────
# VM: MAIN-PRD-FBRG-01 (10.10.60.13)
# HJMM: server1.hjmmlegal.com (10.10.10.10) — two shares
CIFS_CLIENTS_PATH=//10.10.10.10/clients
CIFS_DOCSEND_PATH=//10.10.10.10/docsend
# Legacy: /docsend is from old scanning system. Inconsistent naming.
# DMS crawler indexes both. New files go to /clients with clean naming.

CIFS_USERNAME=<REPLACE>
CIFS_PASSWORD=<REPLACE>
CIFS_DOMAIN=hjmmlegal.com
WEBDAV_PORT=8080

# ─── RQ Workers ──────────────────────────────────────────────────────────
RQ_QUEUES=default,billing,dms,court,ediscovery,intelligence
WORKER_REPLICAS=4

# ─── AI Service ──────────────────────────────────────────────────────────
# Rule 4: All AI calls via AIService only — never call SDK directly
AI_PROVIDER=anthropic
# Options: anthropic, openai

ANTHROPIC_API_KEY=<REPLACE>
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=<REPLACE>
OPENAI_MODEL=gpt-4o

# ─── Email Service ───────────────────────────────────────────────────────
EMAIL_ADAPTER=exchange_ews
# Options: exchange_ews, microsoft_graph, google_workspace

# Exchange EWS (on-premises)
EXCHANGE_SERVER=https://10.10.10.22/EWS/Exchange.asmx
# HJMM: MAIN-MGMT-EXCH-01
EXCHANGE_USERNAME=<REPLACE>
EXCHANGE_PASSWORD=<REPLACE>
EXCHANGE_DOMAIN=hjmmlegal.com

# Microsoft Graph (Office 365)
GRAPH_TENANT_ID=<REPLACE>
GRAPH_CLIENT_ID=<REPLACE>
GRAPH_CLIENT_SECRET=<REPLACE>

# Google Workspace
GOOGLE_SERVICE_ACCOUNT_JSON=<REPLACE-PATH>
GOOGLE_DELEGATED_USER=<REPLACE>

# ─── Calendar Service ────────────────────────────────────────────────────
CALENDAR_ADAPTER=exchange_ews
# Options: exchange_ews, microsoft_graph, google_calendar

# ─── Communication Service ───────────────────────────────────────────────
# FreePBX (CDR integration)
FREEPBX_API_URL=http://10.10.10.23/admin/api
# HJMM: MAIN-MGMT-PBX-01
FREEPBX_API_TOKEN=<REPLACE>

# Twilio (SMS)
TWILIO_ACCOUNT_SID=<REPLACE>
TWILIO_AUTH_TOKEN=<REPLACE>
TWILIO_PHONE_NUMBER=<REPLACE>

# ─── Legal Research Service ──────────────────────────────────────────────
RESEARCH_ADAPTER=none
# Options: westlaw, lexisnexis, none

WESTLAW_CLIENT_ID=<REPLACE>
WESTLAW_CLIENT_SECRET=<REPLACE>

LEXIS_API_KEY=<REPLACE>

# ─── Accounting Service ──────────────────────────────────────────────────
ACCOUNTING_ADAPTER=none
# Options: quickbooks_online, quickbooks_desktop, none

QBO_CLIENT_ID=<REPLACE>
QBO_CLIENT_SECRET=<REPLACE>
QBO_REALM_ID=<REPLACE>
QBO_REFRESH_TOKEN=<REPLACE>

# ─── Authentication ──────────────────────────────────────────────────────
AUTH_ADAPTER=ldaps
# Options: local, ldaps, azure_ad, google, okta, saml, oidc

# LDAPS (Active Directory)
LDAP_SERVER=ldaps://dc01.hjmmlegal.com:636
# HJMM: MAIN-MGMT-AD-01
LDAP_BASE_DN=DC=hjmmlegal,DC=com
LDAP_BIND_DN=<REPLACE>
LDAP_BIND_PASSWORD=<REPLACE>
LDAP_USER_SEARCH_BASE=OU=Users,DC=hjmmlegal,DC=com

# Azure AD / Entra ID
AZURE_AD_TENANT_ID=<REPLACE>
AZURE_AD_CLIENT_ID=<REPLACE>
AZURE_AD_CLIENT_SECRET=<REPLACE>

# ─── ManicTime (desktop time tracking) ───────────────────────────────────
MANICTIME_SERVER_URL=<REPLACE>
MANICTIME_API_KEY=<REPLACE>

# ─── LawPay (payment processing) ────────────────────────────────────────
LAWPAY_API_KEY=<REPLACE>
LAWPAY_WEBHOOK_SECRET=<REPLACE>

# ─── Tyler / Odyssey (court e-filing) ────────────────────────────────────
TYLER_API_URL=<REPLACE>
TYLER_API_KEY=<REPLACE>

# ─── PACER ───────────────────────────────────────────────────────────────
PACER_USERNAME=<REPLACE>
PACER_PASSWORD=<REPLACE>
