# ═══════════════════════════════════════════════════════════
# DMS & Auth Module — Environment Variables
# Add these to your .env file on MAIN-PRD-WEB-01
# ═══════════════════════════════════════════════════════════

# COMP 1: CIFS Storage (file-bridge on FBRG-01)
CIFS_URL=http://10.10.60.13:8080
CIFS_TIMEOUT=30

# COMP 2: File Crawler (RQ on PROC-01)
REDIS_URL=redis://10.10.60.12:6379/0

# COMP 4: Meilisearch (on PROC-01)
MEILISEARCH_URL=http://10.10.60.12:7700
MEILISEARCH_MASTER_KEY=your-meilisearch-key-here

# COMP 7: WebDAV
JWT_SECRET=your-jwt-secret-here

# COMP 9: Lexis+ API
LEXIS_API_URL=https://api.lexisnexis.com/v1
LEXIS_API_KEY=your-lexis-api-key
LEXIS_TIMEOUT=30

# COMP 9: Westlaw Edge API
WESTLAW_API_URL=https://api.westlaw.com/v2
WESTLAW_API_KEY=your-westlaw-api-key
WESTLAW_CLIENT_ID=your-westlaw-client-id
WESTLAW_TIMEOUT=30

# COMP 15: Whisper STT (on WSS-01)
WHISPER_URL=http://10.10.60.14:8000

# COMP 16: LDAPS Auth (HJMM test bed)
LDAP_URL=ldaps://dc01.hjmmlegal.com:636
LDAP_BASE_DN=DC=hjmmlegal,DC=com
LDAP_BIND_DN=CN=praesidium,OU=Service Accounts,DC=hjmmlegal,DC=com
LDAP_BIND_PASSWORD=your-ldap-service-password
LDAP_USER_SEARCH_BASE=OU=Users,DC=hjmmlegal,DC=com
LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=hjmmlegal,DC=com
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_VERIFY_CERT=true

# COMP 17: Azure AD / Entra ID
AZURE_AD_TENANT_ID=your-azure-tenant-id
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret

# File Bridge container (.env on FBRG-01)
CIFS_CLIENTS_MOUNT=/mnt/clients
CIFS_DOCSEND_MOUNT=/mnt/docsend
