    state:           document.getElementById('ce-state').value.trim().toUpperCase(),
    zip_code:        document.getElementById('ce-zip_code').value.trim(),
    notes:           document.getElementById('ce-notes').value.trim(),
    is_active:       document.getElementById('ce-is_active').value === 'true',
  };

  if (!payload.client_name) {
    const e = document.getElementById('client-modal-error');
    e.textContent = 'Client name is required.';
    e.style.display = 'block';
    btn.textContent = 'Save Changes'; btn.disabled = false;
    return;
  }

  const errEl = document.getElementById('client-modal-error');
  try {
    const res = await fetch('/api/billing/clients/{{ client.id }}', {
      method: 'PUT',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      closeClientEditModal();
      // Update visible header without full reload
      document.querySelector('h2').textContent = payload.client_name;
      Object.assign(CLIENT_DATA, payload);
    } else {
      const err = await res.json();
      errEl.textContent   = err.detail || 'Error saving client.';
      errEl.style.display = 'block';
    }
  } catch(e) {
    errEl.textContent   = 'Network error. Please try again.';
    errEl.style.display = 'block';
  } finally {
    btn.textContent = 'Save Changes'; btn.disabled = false;
  }
}

// Close modal on overlay click
document.getElementById('client-edit-overlay')
  .addEventListener('click', function(e) {
    if (e.target === this) closeClientEditModal();
  });

// ── Inline Slip Editing ───────────────────────────────────────────────────────
// After the billing_recent_slips widget loads, slip rows have data-slip attr.
// Clicking a row expands an inline edit form beneath it.


function toggleInlineSlipEdit(row) {
  // If clicking the already-open row, close it
  if (_activeSlipRow === row) {
    closeInlineSlipEdit();
    return;
  }
  // Close any existing open row
  closeInlineSlipEdit();

  const slip = JSON.parse(row.dataset.slip);
  _activeSlipRow = row;
  row.style.background = '#EFF6FF';

  const colCount = row.cells.length;
  const editRow = document.createElement('tr');
  editRow.id = 'inline-slip-edit-row';
  editRow.innerHTML = `
    <td colspan="${colCount}" style="padding:12px 16px; background:#F8FAFF;
        border-bottom:2px solid var(--primary);">
      <div style="display:grid; grid-template-columns:140px 180px 80px 90px 1fr auto;
                  gap:10px; align-items:end;">

        <div>
          <div style="font-size:10px; font-weight:600; color:var(--muted);
                      margin-bottom:3px;">DATE</div>
          <input type="date" id="is-date" value="${slip.slip_date || ''}"
                 style="width:100%; border:1px solid #D1D5DB; border-radius:4px;
                        padding:5px 8px; font-size:12px;">
        </div>

        <div>
          <div style="font-size:10px; font-weight:600; color:var(--muted);
                      margin-bottom:3px;">TIMEKEEPER</div>
          <select id="is-tk"
                  style="width:100%; border:1px solid #D1D5DB; border-radius:4px;
                         padding:5px 8px; font-size:12px; background:#fff;">
            <option value="${slip.source_tk_id}">${slip.tk_name}</option>
          </select>
        </div>

        <div>
          <div style="font-size:10px; font-weight:600; color:var(--muted);
                      margin-bottom:3px;">HOURS</div>
          <input type="number" id="is-hours" value="${parseFloat(slip.hours||0).toFixed(2)}"
                 step="0.1" min="0" max="24"
                 style="width:100%; border:1px solid #D1D5DB; border-radius:4px;
                        padding:5px 8px; font-size:12px;"
                 oninput="updateInlineValue()">
        </div>

        <div>
          <div style="font-size:10px; font-weight:600; color:var(--muted);
                      margin-bottom:3px;">RATE</div>
          <input type="number" id="is-rate" value="${parseFloat(slip.rate||0).toFixed(2)}"
                 step="0.01" min="0"
                 style="width:100%; border:1px solid #D1D5DB; border-radius:4px;
                        padding:5px 8px; font-size:12px;"
                 oninput="updateInlineValue()">
        </div>

        <div>
          <div style="font-size:10px; font-weight:600; color:var(--muted);
                      margin-bottom:3px;">NARRATIVE</div>
          <input type="text" id="is-narrative"
                 value="${(slip.narrative||'').replace(/paid by dmh[^;.]*/gi,'').trim()}"
                 style="width:100%; border:1px solid #D1D5DB; border-radius:4px;
                        padding:5px 8px; font-size:12px;">
        </div>

        <div style="display:flex; gap:6px; align-items:flex-end; padding-bottom:1px;">
          <div style="font-size:11px; font-weight:600; color:var(--primary);
                      white-space:nowrap; padding:5px 0;" id="is-value">
            $${(parseFloat(slip.hours||0)*parseFloat(slip.rate||0)).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}
          </div>
          <select id="is-billed"
                  style="border:1px solid #D1D5DB; border-radius:4px;
                         padding:5px 6px; font-size:11px; background:#fff;">
            <option value="false" ${!slip.billed?'selected':''}>WIP</option>
            <option value="true"  ${slip.billed?'selected':''}>Billed</option>
          </select>
          <button onclick="saveInlineSlip('${slip.source_slip_id}')"
                  style="padding:5px 12px; background:var(--primary); color:#fff;
                         border:none; border-radius:4px; font-size:12px;
                         font-weight:500; cursor:pointer; white-space:nowrap;"
                  id="is-save-btn">Save</button>
          <button onclick="closeInlineSlipEdit()"
                  style="padding:5px 8px; border:1px solid #D1D5DB; background:#fff;
                         border-radius:4px; font-size:12px; cursor:pointer;">✕</button>
        </div>

      </div>
      <div id="is-error"
           style="display:none; margin-top:8px; font-size:11px; color:#dc2626;"></div>
    </td>`;

  row.parentNode.insertBefore(editRow, row.nextSibling);

  // Populate timekeeper dropdown
  fetch('/api/billing/timekeepers')
    .then(r => r.json())
    .then(data => {
      const sel = document.getElementById('is-tk');
      if (!sel) return;
      sel.innerHTML = '';
      (data.timekeepers || []).forEach(tk => {
        const opt = document.createElement('option');
        opt.value = tk.ts_tk_id;
        opt.textContent = `${tk.ts_name} (${tk.ts_initials || tk.ts_tk_id})`;
        if (tk.ts_tk_id === slip.source_tk_id) opt.selected = true;
        sel.appendChild(opt);
      });
    })
    .catch(() => {});
}

function closeInlineSlipEdit() {
  const existing = document.getElementById('inline-slip-edit-row');
  if (existing) existing.remove();
  if (_activeSlipRow) {
    _activeSlipRow.style.background = '';
    _activeSlipRow = null;
  }
}

function updateInlineValue() {
  const h = parseFloat(document.getElementById('is-hours').value || 0);
  const r = parseFloat(document.getElementById('is-rate').value  || 0);
  const el = document.getElementById('is-value');
  if (el) el.textContent = '$' + (h*r).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
}

async function saveInlineSlip(slipId) {
  const btn = document.getElementById('is-save-btn');
  btn.textContent = '…'; btn.disabled = true;

  const billed = document.getElementById('is-billed').value === 'true';
  const hours  = parseFloat(document.getElementById('is-hours').value || 0);
  const rate   = parseFloat(document.getElementById('is-rate').value  || 0);

  const payload = {
    slip_date:    document.getElementById('is-date').value,
    source_tk_id: document.getElementById('is-tk').value,
    hours,
    rate,
    narrative:    document.getElementById('is-narrative').value.trim(),
    billed,
    wip_value:    billed ? 0 : round2(hours * rate),
    billed_value: billed ? round2(hours * rate) : 0,
  };

  const errEl = document.getElementById('is-error');
  try {
    const res = await fetch(`/api/billing/ts-slips/${slipId}`, {
      method:  'PUT',
      headers: {'Content-Type': 'application/json'},
      body:    JSON.stringify(payload),
    });
    if (res.ok) {
      closeInlineSlipEdit();
      // Reload KPI and slips widgets
      htmx.trigger(document.getElementById('widget-client-kpi'),   'load');
      htmx.trigger(document.getElementById('widget-recent-slips'), 'load');
      htmx.trigger(document.getElementById('widget-wip-by-tk'),    'load');
    } else {
      const err = await res.json();
      errEl.textContent   = err.detail || 'Error saving.';
      errEl.style.display = 'block';
      btn.textContent = 'Save'; btn.disabled = false;
    }
  } catch(e) {
    errEl.textContent   = 'Network error.';
    errEl.style.display = 'block';
    btn.textContent = 'Save'; btn.disabled = false;
  }
}

function round2(n) { return Math.round(n * 100) / 100; }

// After slips widget loads, replace openSlipDrawer with inline toggle
document.body.addEventListener('htmx:afterSwap', function(e) {
  if (e.target.id === 'widget-recent-slips') {
    document.querySelectorAll('.slip-row').forEach(function(row) {
      // Replace onclick with inline edit toggle
      row.onclick = function() { toggleInlineSlipEdit(this); };
    });
  }
});
</script>

{% endblock %}
